<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.whatsap.whatunban">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="29" />

    <!-- ========================================
	IZIN DASAR
	======================================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- ========================================
	IZIN NOTIFIKASI (Android 13+)
	======================================== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />

    <!-- ========================================
	IZIN SHIZUKU
	======================================== -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- ========================================
	IZIN SISTEM
	======================================== -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- ========================================
	IZIN OVERLAY / FLOATING WIDGET
	======================================== -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ========================================
	IZIN FOREGROUND SERVICE (Android 9+)
	======================================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- ========================================
	IZIN QUERY PACKAGES (Android 11+)
	======================================== -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".GlobalApplication"
        android:allowBackup="true"
        android:icon="@drawable/icon_apk"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Light.NoTitleBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku required metadata -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <service
            android:name=".GameNotificationListener"
            android:label="Game Notification Blocker"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".PairingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.whatsap.whatunban.ACTION_PAIR" />
            </intent-filter>
        </receiver>

        <activity android:name=".GlobalApplication$CrashActivity" />

    </application>

</manifest>
